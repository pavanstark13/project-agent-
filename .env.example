# Database
DATABASE_URL=postgresql+asyncpg://trader:trader_pass@localhost:5432/trading_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Service URLs (internal docker network)
MARKET_DATA_SERVICE_URL=http://market-data:8001
STRATEGY_ENGINE_URL=http://strategy-engine:8002
RISK_MANAGEMENT_URL=http://risk-management:8003
EXECUTION_ENGINE_URL=http://execution-engine:8004
AI_AGENT_URL=http://ai-agent:8005
MONITORING_URL=http://monitoring:8006

# AI Provider — set to "gemini" (free) or "claude" (paid)
AI_PROVIDER=gemini

# Google Gemini — FREE tier: 1,500 req/day, no credit card
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude — PAID (switch when ready for production)
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# Broker - Alpaca
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Security
SECRET_KEY=your_super_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
DEBUG=false
ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres (used by docker-compose)
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader_pass
POSTGRES_DB=trading_db

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_pass

# Trading API (src/api.py) — required for uvicorn src.api:app
EXCHANGE_NAME=binance
EXCHANGE_API_KEY=your_exchange_api_key
EXCHANGE_API_SECRET=your_exchange_api_secret
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_SIZE=0.001
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.05
TRAILING_STOP_PCT=0.025
DAILY_LOSS_CAP_PCT=0.05
WIN_RATE_MIN=0.55
VALIDATION_SHARPE_MIN=0.5
VALIDATION_RETURN_MIN=0.0
POLL_INTERVAL_SECONDS=3600
DEPLOYMENT_MODE=paper
DATA_SOURCE=ccxt

# AWS S3 (for cloud data storage & model persistence)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=my-trading-agent-bucket
